includes:
	- vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
	- vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
	- phpstan-baseline.neon

parameters:
	checkGenericClassInNonGenericObjectType: false
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		# Wider patterns to cover PHPStan / dependency version drift between CI runners.
		# The concrete grandfathered occurrences live in phpstan-baseline.neon.
		- '#^Cannot access property \$homepage on array#'
		- '#^Call to deprecated method setTempDirectory\(\) of class Latte\\Engine#'
		- '#^Method Baraja\\Cms\\Translator\\CmsDefaultTranslator::translate\(\) has parameter#'
		- '#^Method Baraja\\Cms\\Translator\\TranslatorFilter::__invoke\(\) should return string but returns string\|Stringable\.#'
		- '#^Parameter \#1 \$message of method Nette\\Localization\\Translator::translate\(\) expects string\|Stringable, mixed given\.#'
